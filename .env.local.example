# Supabase Project Configuration
# Replace these with your Supabase Project settings (Project Settings -> API)

# Supabase URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (ONLY used for server-side administrative tasks and db:seed scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here